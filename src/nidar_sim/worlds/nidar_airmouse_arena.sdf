          <pose>0.5 0 0.15 0 0 0</pose>
          <geometry>
            <sphere><radius>0.14</radius></sphere>
          </geometry>
          <material>
            <ambient>0.9 0.75 0.6 1</ambient>
            <diffuse>0.95 0.8 0.65 1</diffuse>
          </material>
        </visual>
        <visual name="limbs">
          <pose>-0.5 0 0.08 0 0 0</pose>
          <geometry>
            <box><size>0.6 0.35 0.15</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box><size>1.2 0.5 0.3</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Survivor 3: Central Chamber -->
    <model name="survivor_3">
      <static>true</static>
      <pose>7.5 7.5 0.15 0 0 0</pose>
      <link name="body">
        <visual name="torso">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.4 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
