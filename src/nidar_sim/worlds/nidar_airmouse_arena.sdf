    <!-- Survivor 5: Room D -->
    <model name="survivor_5">
      <static>true</static>
      <pose>12.5 12.5 0.15 0 0 0</pose>
      <link name="body">
        <visual name="torso">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.4 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
