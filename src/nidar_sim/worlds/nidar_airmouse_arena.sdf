<model name="nidar_drone">
    <pose>0.6 1.0 0.25 0 0 0</pose>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <!-- Roll/Pitch inertia -->
        <inertia>
          <ixx>5.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.0</iyy>
          <iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      
      <!-- Main chassis -->
      <visual name="body_visual">
        <geometry>
          <box><size>0.30 0.30 0.08</size></box>
        </geometry>
        <material>
          <ambient>0.0 0.8 1.0 1.0</ambient>
          <diffuse>0.0 0.9 1.0 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>

      <!-- Heading indicator -->
      <visual name="front_nose_visual">
        <pose>0.16 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.08 0.12 0.06</size></box>
        </geometry>
        <material>
          <ambient>1.0 0.1 0.1 1.0</ambient>
          <diffuse>1.0 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Propeller guards -->
      <visual name="guard_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.6 0.0 0.6</ambient>
          <diffuse>1.0 0.6 0.0 0.6</diffuse>
        </material>
      </visual>

      <!-- Collision geometry -->
      <collision name="drone_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.28</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
        </surface>
      </collision>

      <!-- Rotors -->
      <visual name="rotor_0">
        <pose>0.15 0.15 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.3 0.3 0.3 0.8</diffuse></material>
      </visual>
      <visual name="rotor_1">
        <pose>0.15 -0.15 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.3 0.3 0.3 0.8</diffuse></material>
      </visual>
      <visual name="rotor_2">
        <pose>-0.15 0.15 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.3 0.3 0.3 0.8</diffuse></material>
      </visual>
      <visual name="rotor_3">
        <pose>-0.15 -0.15 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.8</ambient><diffuse>0.3 0.3 0.3 0.8</diffuse></material>
      </visual>

      <!-- 2D LiDAR -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.08 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <!-- RGB Camera -->
      <sensor name="camera" type="camera">
        <pose>0.14 0 0.02 0 0.6 0</pose>
        <topic>/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Velocity control -->
    <plugin
      filename="ignition-gazebo-velocity-control-system"
      name="ignition::gazebo::systems::VelocityControl">
      <topic>/cmd_vel</topic>
      <link_name>base_link</link_name>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
    </plugin>

    <!-- Odometry publisher -->
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </model>
  </world>
</sdf>
