    <!-- Survivor 6: Room E -->
    <model name="survivor_6">
      <static>true</static>
      <pose>7.5 12.5 0.15 0 0 0</pose>
      <link name="body">
        <visual name="torso">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.4 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
